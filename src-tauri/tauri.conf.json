{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pebble Launcher",
  "version": "0.1.0",
  "identifier": "io.pebble.launcher",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pebble Launcher",
        "width": 830,
        "height": 550,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#15191d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Minimal Minecraft Java Edition launcher",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
